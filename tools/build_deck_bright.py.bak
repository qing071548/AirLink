BG      = RGBColor(0xF5, 0xF7, 0xFB)
BG2     = RGBColor(0xEC, 0xF1, 0xF9)
CARD    = RGBColor(0xFF, 0xFF, 0xFF)
LINE    = RGBColor(0xE2, 0xE8, 0xF2)
INK     = RGBColor(0x0F, 0x17, 0x2A)
SUB     = RGBColor(0x4B, 0x57, 0x6E)
MUTED   = RGBColor(0x7C, 0x87, 0x9C)
ACC     = RGBColor(0x25, 0x63, 0xEB)
ACC2    = RGBColor(0x7C, 0x3A, 0xED)
