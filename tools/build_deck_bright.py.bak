footer(s, 16)

# =================================================================== 17 结语
s = new_slide(RGBColor(0xFA, 0xFB, 0xFE), RGBColor(0xEA, 0xF0, 0xFA))


textbox(s, X0, 2.86, CW, 1.2, "两台设备之间，", 36, INK, bold=True, line=1.25)
textbox(s, X0, 3.92, CW, 1.2, "不该有中间商。", 36, ACC, bold=True, line=1.25)
textbox(s, X0, 5.10, CW, 0.45, "小、快、直——就这三件事。", 15, SUB)

feats = [("小", "699 KB / 333 KB"), ("快", "点对点直连"), ("直", "不经任何服务器")]
y = 5.94
for k, v in feats:
    card(s, X0, y, CW, 1.20)
    textbox(s, X0 + 0.40, y + 0.26, 0.9, 0.7, k, 26, ACC, bold=True)
    textbox(s, X0 + 1.30, y + 0.44, CW - 1.6, 0.4, v, 12, SUB)
    y += 1.38

rect(s, X0, 10.06, CW, 0.012, fill=RGBColor(0xD8, 0xE1, 0xEF))
textbox(s, X0, 10.30, CW, 1.0,
        "AirLink · 隔空快传\nWindows 与 Android 双端就绪", 11, MUTED, line=1.75)

NOTES = [
 "开场定位：让两台设备直接对话的工具，电脑一个 exe、手机一个 apk，中间不需要任何服务器。",
 "四个场景对应线、压缩、等待、跨网。共同点：文件必须经过第三方。",
 "三个不做的边界，三个直接的主线。",
 "体积是结果不是目标：界面自绘、零框架、零图片资源。",
 "六项能力是一条完整链路。",
 "局域网走 UDP 广播，只在同一广播域有效，所以还需要广域网方案。",
 "二维码里是完整连接串，手机自动判断走哪条路径。",
 "优先 IPv6，无则退回 UPnP 端口映射。",
 "非内网来源必须先出示配对码，通过后十分钟免检。",
 "双向浏览，大文件按块流式传输。",
 "记录不是事后日志，而是传输过程的一部分。",
 "四层保活手段叠加，设置页可观测。",
 "数字都可以核对，不放无法验证的宣称。",
 "三层结构，两端共用一份协议定义。",
 "重点是：中间那一层其实可以不存在。",
 "四个典型场景。",
 "收尾：两台设备之间不该有中间商。",
]

for sl, note in zip(prs.slides, NOTES):
    sl.notes_slide.notes_text_frame.text = note

kinds = ["fade", "push", "wipe", "zoom", "cover", "fade", "push", "fade", "wipe"]
for i, sl in enumerate(prs.slides):
    transition(sl, kinds[i % len(kinds)])

prs.save(OUT)
print("saved", OUT)
