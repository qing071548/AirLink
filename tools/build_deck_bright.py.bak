    card(s, X0, y, CW, 1.52)
    rect(s, X0, y, 0.08, 1.52, fill=accent)
    textbox(s, X0 + 0.40, y + 0.30, CW - 0.8, 0.36, t, 16, INK, bold=True)
    textbox(s, X0 + 0.40, y + 0.82, CW - 0.8, 0.4, d, 11.5, SUB)
    y += 1.74

textbox(s, X0, y + 0.10, CW, 0.9,
        "设置页能直接看到保活是否成功，\n出问题可以自己判断。", 11, MUTED, line=1.7)
footer(s, 12)

# =================================================================== 13 指标
s = new_slide(RGBColor(0xFA, 0xFB, 0xFE), RGBColor(0xEC, 0xF1, 0xF9))
head(s, "BY THE NUMBERS", "几个能对得上的数字", "全部取自实际构建产物。", lead_y=2.34)

stats = [
    ("699", "KB", "电脑端体积"),
    ("333", "KB", "手机端体积"),
    ("0", "个", "运行时依赖"),
    ("6", "字节", "协议头开销"),
    ("2", "个", "网络端口"),
    ("10", "分钟", "配对码有效期"),
]
cw3, ch3, gx3, gy3 = 3.02, 2.28, 0.26, 0.30
for i, (num, unit, label) in enumerate(stats):
    col, row = i % 2, i // 2
    x = X0 + col * (cw3 + gx3)
    y = 2.98 + row * (ch3 + gy3)
    card(s, x, y, cw3, ch3)
    textbox(s, x + 0.34, y + 0.54, 2.6, 0.9, num, 46, INK, bold=True)
    textbox(s, x + 0.34 + len(num) * 0.36 + 0.08, y + 0.90, 1.2, 0.34, unit, 13, ACC, bold=True)
    textbox(s, x + 0.34, y + 1.60, cw3 - 0.68, 0.34, label, 11.5, MUTED)
footer(s, 13)

# =================================================================== 14 架构
s = new_slide()
head(s, "ARCHITECTURE", "三层结构\n两端逐字节一致", "两端共用同一份协议定义。", lead_y=2.34)

layers = [
    ("发现层", "UDP 45679", "广播探询与应答，仅局域网可见", ACC, 1.86),
    ("传输层", "TCP 45678", "ALFT 魔数 + 版本 + 类型", ACC2, 1.86),
    ("应用层", "12 类消息", "推文件 · 列目录 · 取文件 · 心跳\n会话 · 删除 · 记录同步 · 配对认证", GREEN, 2.30),
]
y = 3.06
for name, port, desc, accent, h in layers:
    card(s, X0, y, CW, h)
    rect(s, X0, y, 0.08, h, fill=accent)
    textbox(s, X0 + 0.40, y + 0.30, 2.2, 0.36, name, 15.5, INK, bold=True)
    tag = rect(s, X0 + 2.62, y + 0.28, 1.86, 0.38,
               fill=RGBColor(0xF2, 0xF6, 0xFD), line=RGBColor(0xD3, 0xDF, 0xF2), radius=0.5)
    shape_text(tag, port, 10, accent, bold=True)
    textbox(s, X0 + 0.40, y + 0.88, CW - 0.8, 1.1, desc, 11, SUB, line=1.55)
    y += h + 0.26

textbox(s, X0, y + 0.10, CW, 0.9,
        "协议只有 6 字节头部，其余全是负载——\n把开销留给数据本身。", 11, MUTED, line=1.7)
footer(s, 14)

# =================================================================== 15 对比
s = new_slide()
head(s, "COMPARISON", "换一种方式看它", "没有一种工具适合所有场景。", lead_y=2.34)

cols = ["", "AirLink", "聊天", "网盘", "数据线"]
col_x = [X0, X0 + 2.16, X0 + 3.56, X0 + 4.62, X0 + 5.68]
col_w = [2.16, 1.40, 1.06, 1.06, 0.86]
rows = [
    ("需要账号", "否", "是", "是", "否"),
    ("需要联网", "否", "是", "是", "否"),
    ("经服务器", "否", "是", "是", "否"),
    ("压缩画质", "不压缩", "会压缩", "不压缩", "不压缩"),
    ("跨网络", "支持", "支持", "支持", "不支持"),
    ("免安装", "单文件", "需安装", "需安装", "需驱动"),
]
hy = 3.10
for i, c in enumerate(cols):
    if i == 0:
        continue
    fill = RGBColor(0xDD, 0xE8, 0xFC) if i == 1 else RGBColor(0xF0, 0xF4, 0xFA)
    sh = rect(s, col_x[i], hy, col_w[i], 0.52, fill=fill, line=None, radius=0.14)
    shape_text(sh, c, 10, ACC if i == 1 else SUB, bold=True)

for r, (label, *vals) in enumerate(rows):
    y = hy + 0.64 + r * 0.86
    if r % 2 == 0:
        rect(s, X0, y - 0.08, CW, 0.80, fill=RGBColor(0xEF, 0xF3, 0xFA), line=None)
    textbox(s, col_x[0] + 0.10, y + 0.18, col_w[0] - 0.16, 0.34, label, 10.5, SUB)
    for c, v in enumerate(vals):
        good = (c == 0)
        ok = v in ("否", "不压缩", "支持", "单文件")
        col = (GREEN if ok else INK) if good else MUTED
        textbox(s, col_x[c + 1] + 0.04, y + 0.18, col_w[c + 1] - 0.06, 0.34,
                v, 10, col, bold=good)

textbox(s, X0, 8.62, CW, 1.5,
        "如果目标只是把文件从 A 送到 B，\n中间那一层其实可以不存在。", 12, SUB, line=1.7)
footer(s, 15)

# =================================================================== 16 场景
s = new_slide()
head(s, "USE CASES", "什么时候用得上", "两台设备在同一个屏幕前，或同一个人在两地。", lead_y=2.34)

scenes = [
    ("办公室换机", "整目录搬到新机器，不用上传"),
    ("照片回传", "手机拍完传电脑修图，不损画质"),
    ("出差在外", "IPv6 直连公司电脑，不用 VPN"),
    ("断网环境", "同一路由器内照样互传"),
]
