#include <windows.h>

1 ICON "app.ico"

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "AirLink"
            VALUE "FileDescription",  "AirLink - LAN / USB File Transfer"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "AirLink"
            VALUE "OriginalFilename", "AirLink.exe"
            VALUE "ProductName",      "AirLink"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
